{
    "Comment": "A description of my state machine",
    "StartAt": "Lambda Invoke",
    "States": {
        "Lambda Invoke": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Output": "{% $states.result.Payload %}",
            "Arguments": {
                "Payload": "{% $states.input %}",
                "FunctionName": "arn:aws:lambda:eu-central-1:915238109570:function:amazon-books-scraper:$LATEST"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                },
                {
                    "ErrorEquals": [
                        "RuntimeError"
                    ],
                    "IntervalSeconds": 60,
                    "MaxAttempts": 2,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL",
                    "Comment": "Amazon anti-bot (503) \u2014 pusty scrape jest przejsciowy, nie defekt kodu"
                }
            ],
            "Next": "GetPartitionsBefore"
        },
        "GetPartitionsBefore": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:glue:getPartitions",
            "Arguments": {
                "DatabaseName": "bronze",
                "TableName": "raw"
            },
            "Assign": {
                "partitionsBefore": "{% $count($states.result.Partitions) %}",
                "scrapedCount": "{% $states.input.scraped_count ? $states.input.scraped_count : null %}"
            },
            "Next": "MsckRepair"
        },
        "MsckRepair": {
            "Type": "Task",
            "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
            "Arguments": {
                "QueryString": "MSCK REPAIR TABLE bronze.raw;",
                "WorkGroup": "primary",
                "ResultConfiguration": {
                    "OutputLocation": "s3://amazon-books-etl-aws-915238109570/athena-results/"
                }
            },
            "Next": "GetPartitionsAfter"
        },
        "GetPartitionsAfter": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:glue:getPartitions",
            "Arguments": {
                "DatabaseName": "bronze",
                "TableName": "raw"
            },
            "Assign": {
                "partitionsAfter": "{% $count($states.result.Partitions) %}"
            },
            "Next": "WriteRunLog"
        },
        "WriteRunLog": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
            "Arguments": {
                "Bucket": "amazon-books-etl-aws-915238109570",
                "Key": "{% 'logs/pipeline_runs/dt=' & $substring($states.context.Execution.StartTime, 0, 10) & '/' & $states.context.Execution.Name & '.json' %}",
                "Body": "{% $string({\"run_id\": $states.context.Execution.Name, \"execution_arn\": $states.context.Execution.Id, \"start_time\": $states.context.Execution.StartTime, \"scraped_count\": $scrapedCount, \"partitions_before\": $partitionsBefore, \"partitions_after\": $partitionsAfter, \"partitions_added\": $partitionsAfter - $partitionsBefore, \"backlog_recovered\": ($partitionsAfter - $partitionsBefore) > 1}) %}"
            },
            "Next": "ECS RunTask"
        },
        "ECS RunTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Arguments": {
                "LaunchType": "FARGATE",
                "Cluster": "arn:aws:ecs:eu-central-1:915238109570:cluster/amazon-books-cluster",
                "TaskDefinition": "arn:aws:ecs:eu-central-1:915238109570:task-definition/dbt-runner",
                "NetworkConfiguration": {
                    "AwsvpcConfiguration": {
                        "Subnets": [
                            "subnet-08f1a5fe7626621c4"
                        ],
                        "SecurityGroups": [
                            "sg-03d822b4dbea16977"
                        ],
                        "AssignPublicIp": "ENABLED"
                    }
                }
            },
            "End": true
        }
    },
    "QueryLanguage": "JSONata"
}
