{
    "Comment": "Scrape -> land partitions -> dbt. Every path ends at LogRun (watcher pattern), so failed runs are logged too.",
    "StartAt": "InitRunVars",
    "States": {
        "InitRunVars": {
            "Type": "Pass",
            "Assign": {
                "runStatus": "succeeded",
                "errorInfo": null,
                "scrapedCount": null,
                "partitionsBefore": null,
                "partitionsAfter": null
            },
            "Next": "Lambda Invoke"
        },
        "Lambda Invoke": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Output": "{% $states.result.Payload %}",
            "Arguments": {
                "Payload": "{% $states.input %}",
                "FunctionName": "arn:aws:lambda:eu-central-1:915238109570:function:amazon-books-scraper:$LATEST"
            },
            "Retry": [
                {
                    "ErrorEquals": [
                        "Lambda.ServiceException",
                        "Lambda.AWSLambdaException",
                        "Lambda.SdkClientException",
                        "Lambda.TooManyRequestsException"
                    ],
                    "IntervalSeconds": 1,
                    "MaxAttempts": 3,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL"
                },
                {
                    "ErrorEquals": [
                        "RuntimeError"
                    ],
                    "IntervalSeconds": 60,
                    "MaxAttempts": 2,
                    "BackoffRate": 2,
                    "JitterStrategy": "FULL",
                    "Comment": "Amazon anti-bot (503) \u2014 pusty scrape jest przejsciowy, nie defekt kodu"
                }
            ],
            "Next": "GetPartitionsBefore",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "LogRun",
                    "Assign": {
                        "runStatus": "failed",
                        "errorInfo": "{% $states.errorOutput %}"
                    }
                }
            ]
        },
        "GetPartitionsBefore": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:glue:getPartitions",
            "Arguments": {
                "DatabaseName": "bronze",
                "TableName": "raw"
            },
            "Assign": {
                "partitionsBefore": "{% $count($states.result.Partitions) %}",
                "scrapedCount": "{% $states.input.scraped_count ? $states.input.scraped_count : null %}"
            },
            "Next": "MsckRepair",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "LogRun",
                    "Assign": {
                        "runStatus": "failed",
                        "errorInfo": "{% $states.errorOutput %}"
                    }
                }
            ]
        },
        "MsckRepair": {
            "Type": "Task",
            "Resource": "arn:aws:states:::athena:startQueryExecution.sync",
            "Arguments": {
                "QueryString": "MSCK REPAIR TABLE bronze.raw;",
                "WorkGroup": "primary",
                "ResultConfiguration": {
                    "OutputLocation": "s3://amazon-books-etl-aws-915238109570/athena-results/"
                }
            },
            "Next": "GetPartitionsAfter",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "LogRun",
                    "Assign": {
                        "runStatus": "failed",
                        "errorInfo": "{% $states.errorOutput %}"
                    }
                }
            ]
        },
        "GetPartitionsAfter": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:glue:getPartitions",
            "Arguments": {
                "DatabaseName": "bronze",
                "TableName": "raw"
            },
            "Assign": {
                "partitionsAfter": "{% $count($states.result.Partitions) %}"
            },
            "Next": "ECS RunTask",
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "LogRun",
                    "Assign": {
                        "runStatus": "failed",
                        "errorInfo": "{% $states.errorOutput %}"
                    }
                }
            ]
        },
        "ECS RunTask": {
            "Type": "Task",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Arguments": {
                "LaunchType": "FARGATE",
                "Cluster": "arn:aws:ecs:eu-central-1:915238109570:cluster/amazon-books-cluster",
                "TaskDefinition": "arn:aws:ecs:eu-central-1:915238109570:task-definition/dbt-runner",
                "NetworkConfiguration": {
                    "AwsvpcConfiguration": {
                        "Subnets": [
                            "subnet-08f1a5fe7626621c4"
                        ],
                        "SecurityGroups": [
                            "sg-03d822b4dbea16977"
                        ],
                        "AssignPublicIp": "ENABLED"
                    }
                }
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "LogRun",
                    "Assign": {
                        "runStatus": "failed",
                        "errorInfo": "{% $states.errorOutput %}"
                    }
                }
            ],
            "Next": "LogRun"
        },
        "LogRun": {
            "Type": "Task",
            "Resource": "arn:aws:states:::aws-sdk:s3:putObject",
            "Arguments": {
                "Bucket": "amazon-books-etl-aws-915238109570",
                "Key": "{% 'logs/pipeline_runs/dt=' & $substring($states.context.Execution.StartTime, 0, 10) & '/' & $states.context.Execution.Name & '.json' %}",
                "Body": "{% $string({\"run_id\": $states.context.Execution.Name, \"execution_arn\": $states.context.Execution.Id, \"start_time\": $states.context.Execution.StartTime, \"status\": $runStatus, \"error\": $errorInfo, \"scraped_count\": $scrapedCount, \"partitions_before\": $partitionsBefore, \"partitions_after\": $partitionsAfter, \"partitions_added\": ($partitionsBefore != null and $partitionsAfter != null) ? $partitionsAfter - $partitionsBefore : null, \"backlog_recovered\": ($partitionsBefore != null and $partitionsAfter != null) ? ($partitionsAfter - $partitionsBefore) > 1 : false}) %}"
            },
            "Catch": [
                {
                    "ErrorEquals": [
                        "States.ALL"
                    ],
                    "Next": "CheckRunStatus"
                }
            ],
            "Next": "CheckRunStatus"
        },
        "CheckRunStatus": {
            "Type": "Choice",
            "Choices": [
                {
                    "Condition": "{% $runStatus = 'failed' %}",
                    "Next": "FailRun"
                }
            ],
            "Default": "SucceedRun"
        },
        "FailRun": {
            "Type": "Fail",
            "Error": "PipelineFailed",
            "Cause": "A pipeline state failed; see the run log in s3://.../logs/pipeline_runs/"
        },
        "SucceedRun": {
            "Type": "Succeed"
        }
    },
    "QueryLanguage": "JSONata"
}
